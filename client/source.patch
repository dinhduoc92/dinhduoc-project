@@ -0,0 +1,86 @@
+"""No inference dependencies: pauses preserve completed sentences and SRT clocks."""
+import asyncio
+import sys
+import time
+import unittest
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).parents[1] / 'backend'))
+from services.generation_control import start, get, cancel, controls
+from services.line_subtitles import LineClock
+
+async def connected(): return False
+async def disconnected(): return True
+KEY = 'a' * 32
+
+class BatchControlTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self): controls.clear()
+    def tearDown(self):
+        for state in controls.values():state.cancelled=True
+        controls.clear()
+
+    async def test_pause_finishes_current_sentence_then_resumes_without_repeats(self):
+        state=start(KEY);state.claimed=True
+        first_started=asyncio.Event();finish_first=asyncio.Event();rendered=[]
+        clock=LineClock(['first','second'])
+        async def run():
+            await state.checkpoint(connected)
+            for index,frames in enumerate([24000,48000]):
+                if index==0:
+                    first_started.set();await finish_first.wait()
+                rendered.append(index);clock.append(frames,24000,500)
+                await state.checkpoint(connected)
+        task=asyncio.create_task(run())
+        await first_started.wait()
+        state.requested=True;state.phase='pausing'
+        self.assertEqual(rendered,[])
+        finish_first.set()
+        for _ in range(100):
+            if state.phase=='paused':break
+            await asyncio.sleep(0.005)
+        self.assertEqual(state.phase,'paused')
+        self.assertEqual(rendered,[0]);self.assertFalse(task.done())
+        state.requested=False;state.touch()
+        await asyncio.wait_for(task,1)
+        self.assertEqual(rendered,[0,1])
+        self.assertEqual(clock.frames,84000)
+        self.assertIn('00:00:01,500 --> 00:00:03,500',clock.srt())
+
+    async def test_cancel_wakes_paused_work(self):
+        state=start(KEY);state.requested=True
+        task=asyncio.create_task(state.checkpoint(connected));await asyncio.sleep(0)
+        cancel(KEY)
+        with self.assertRaises(asyncio.CancelledError):await asyncio.wait_for(task,1)
+        self.assertNotIn(KEY,controls)
+
+    async def test_disconnection_stops_work_and_open_paused_request_does_not_expire(self):
+        state=start(KEY)
+        with self.assertRaises(asyncio.CancelledError):await state.checkpoint(disconnected)
+        state.claimed=True
+        state.touched=time.monotonic()-3600
+        self.assertIs(get(KEY),state)
+        await state.checkpoint(connected)
+
+    async def test_pause_between_files_and_resume_before_boundary(self):
+        state=start(KEY);state.requested=True
+        self.assertEqual(state.status()['state'],'paused')
+        state.requested=False
+        await state.checkpoint(connected)
+        self.assertEqual(state.phase,'running')
+
+    async def test_registry_rejects_duplicates_and_bad_ids_and_prunes_expired(self):
+        with self.assertRaises(ValueError):start('../escape')
+        state=start(KEY)
+        with self.assertRaises(ValueError):start(KEY)
+        state.touched=time.monotonic()-301
+        with self.assertRaises(KeyError):get(KEY)
+        start('b'*32)
+        self.assertNotIn(KEY,controls)
+        self.assertTrue(state.cancelled)
+
+    async def test_other_batch_is_not_paused(self):
+        first=start(KEY);first.requested=True
+        other=start('b'*32)
+        await asyncio.wait_for(other.checkpoint(connected),1)
+        self.assertEqual(other.phase,'running')
+
+if __name__=='__main__':unittest.main()

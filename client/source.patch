+import { randomBytes } from 'node:crypto';
+import { PRODUCT_NAME } from '../../../config/app-config.mjs';
+import vi from '../renderer/src/i18n/locales/vi.json';
+
+export const activationText = vi.deviceActivation;
+const escape = (value: string) =>
+  value.replace(
+    /[&<>"']/g,
+    (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
+  );
+export function activationHtml(): string {
+  const nonce = randomBytes(20).toString('hex');
+  const t = activationText;
+  const messages = JSON.stringify(t).replace(/</g, '\\u003c');
+  return `<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'nonce-${nonce}'; style-src 'nonce-${nonce}'; base-uri 'none'; form-action 'none'"><title>${escape(PRODUCT_NAME)}</title>
+<style nonce="${nonce}">*{box-sizing:border-box}body{margin:0;background:#0d1016;color:#e7eaf0;font:15px 'Segoe UI',sans-serif;display:grid;min-height:100vh;place-items:center;padding:28px}main{width:100%;max-width:650px}h1{font-size:23px;line-height:1.4}h2{font-size:18px;color:#86aaff}p{color:#aab3c4;line-height:1.6}label{display:block;margin:18px 0 8px}#machine{font:22px Consolas,monospace;letter-spacing:2px;user-select:all;padding:14px;border:1px solid #35415a;border-radius:8px;background:#171e2b}button{background:#3569e8;color:white;border:0;border-radius:7px;padding:11px 17px;cursor:pointer;font:inherit;margin-top:12px}button:disabled{opacity:.5;cursor:default}textarea{width:100%;height:145px;resize:vertical;padding:12px;background:#171e2b;border:1px solid #35415a;border-radius:8px;color:#e7eaf0;font:13px Consolas,monospace}#status{min-height:40px;color:#ffbd85;line-height:1.6}footer{font-size:12px;color:#69758c;margin-top:25px}</style></head><body><main><h1>${escape(PRODUCT_NAME)}</h1><h2>${escape(t.title)}</h2><p>${escape(t.help)}</p><label>${escape(t.machine)}</label><div id="machine" role="textbox" aria-readonly="true">…</div><button id="copy" disabled>${escape(t.copy)}</button><label for="key">${escape(t.key)}</label><textarea id="key" spellcheck="false" autocomplete="off"></textarea><button id="activate" disabled>${escape(t.activate)}</button><p id="status" role="alert"></p><footer>RSA-3072 · ${escape(PRODUCT_NAME)}</footer></main>
+<script nonce="${nonce}">const texts=${messages};const api=window.deviceActivation;const status=document.getElementById('status');const copy=document.getElementById('copy');const activate=document.getElementById('activate');let machine='';
+function show(reason){status.textContent=texts[reason]||texts.invalid;}
+if(api){api.info().then(info=>{machine=info.machine;document.getElementById('machine').textContent=machine;copy.disabled=!machine;activate.disabled=!machine;if(info.reason)show(info.reason);}).catch(()=>show('identity'));}else show('authority');
+copy.onclick=()=>api.copy().then(()=>show('copied')).catch(()=>show('invalid'));
+activate.onclick=async()=>{activate.disabled=true;status.textContent='';try{const result=await api.activate(document.getElementById('key').value.trim());if(!result.valid)show(result.reason);}catch{show('invalid')}finally{activate.disabled=false}};
+</script></body></html>`;
+}

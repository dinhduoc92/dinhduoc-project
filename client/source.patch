+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+const f = vi.hoisted(() => ({
+  directory: '',
+  windows: [] as any[],
+  handlers: new Map<string, any>(),
+  verdict: { valid: false, reason: 'invalid' } as any,
+  secure: true,
+  quit: vi.fn(),
+}));
+vi.mock('node:child_process', () => ({
+  execFileSync: () => 'MachineGuid    REG_SZ    11111111-2222-3333-4444-555555555555',
+}));
+vi.mock('./device-license', async (original) => ({
+  ...(await original<typeof import('./device-license')>()),
+  checkDeviceLicense: () => f.verdict,
+}));
+vi.mock('electron', async () => {
+  const { EventEmitter } = await import('node:events');
+  class Window extends EventEmitter {
+    gone = false;
+    hidden = false;
+    webContents: any;
+    constructor(public options: any) {
+      super();
+      this.webContents = new EventEmitter();
+      this.webContents.mainFrame = {};
+      this.webContents.setWindowOpenHandler = vi.fn();
+      f.windows.push(this);
+    }
+    setMenu() {}
+    show() {}
+    hide() {
+      this.hidden = true;
+    }
+    isDestroyed() {
+      return this.gone;
+    }
+    destroy() {
+      this.gone = true;
+      this.emit('closed');
+    }
+    loadURL() {
+      return Promise.resolve();
+    }
+  }
+  return {
+    BrowserWindow: Window,
+    app: { getPath: () => f.directory, once: vi.fn(), quit: f.quit },
+    clipboard: { writeText: vi.fn() },
+    ipcMain: {
+      handle: (name: string, fn: any) => f.handlers.set(name, fn),
+      removeHandler: (name: string) => f.handlers.delete(name),
+    },
+    safeStorage: {
+      isEncryptionAvailable: () => f.secure,
+      encryptString: (s: string) => Buffer.from(s),
+      decryptString: (b: Buffer) => b.toString(),
+    },
+  };
+});
+import { requireDeviceActivation } from './device-activation';
+let directory: string;
+beforeEach(async () => {
+  directory = await mkdtemp(join(tmpdir(), 'activation-'));
+  f.directory = directory;
+  f.windows = [];
+  f.handlers.clear();
+  f.verdict = { valid: false, reason: 'invalid' };
+  f.secure = true;
+  f.quit.mockClear();
+});
+afterEach(async () => {
+  vi.useRealTimers();
+  await rm(directory, { recursive: true, force: true });
+});
+async function opened() {
+  const promise = requireDeviceActivation(vi.fn());
+  await vi.waitFor(() => expect(f.windows.length).toBe(1));
+  const window = f.windows[0];
+  const event = { sender: window.webContents, senderFrame: window.webContents.mainFrame };
+  return { promise, window, event };
+}
+it('opens a sandboxed isolated gate and refuses untrusted frames', async () => {
+  const { promise, window, event } = await opened();
+  expect(window.options.webPreferences.sandbox).toBe(true);
+  expect(window.options.webPreferences.nodeIntegration).toBe(false);
+  expect(window.options.webPreferences.preload).toMatch(/activation\.cjs$/);
+  expect(() => f.handlers.get('device-license:copy')({ ...event, senderFrame: {} })).toThrow();
+  window.destroy();
+  expect(await promise).toBeNull();
+  expect(f.quit).toHaveBeenCalled();
+  expect(f.handlers.size).toBe(0);
+});
+it('keeps invalid activation locked without writing a license', async () => {
+  const { promise, window, event } = await opened();
+  expect(await f.handlers.get('device-license:activate')(event, 'bad')).toEqual({
+    valid: false,
+    reason: 'invalid',
+  });
+  await expect(readFile(join(directory, 'device-activation.dat'))).rejects.toBeDefined();
+  expect(window.hidden).toBe(false);
+  window.destroy();
+  await promise;
+});
+it('does not unlock when secure storage is unavailable', async () => {
+  const { promise, window, event } = await opened();
+  f.secure = false;
+  f.verdict = { valid: true, claims: {} };
+  expect(await f.handlers.get('device-license:activate')(event, 'verified')).toEqual({
+    valid: false,
+    reason: 'storage',
+  });
+  expect(window.hidden).toBe(false);
+  window.destroy();
+  await promise;
+});
+it('stores a verified token and keeps the gate alive until the app window is ready', async () => {
+  const { promise, window, event } = await opened();
+  f.verdict = { valid: true, claims: {} };
+  expect(await f.handlers.get('device-license:activate')(event, 'verified')).toEqual({
+    valid: true,
+  });
+  const lease = await promise;
+  expect(window.hidden).toBe(true);
+  expect(window.isDestroyed()).toBe(false);
+  expect(JSON.parse(await readFile(join(directory, 'device-activation.dat'), 'utf8')).token).toBe(
+    'verified',
+  );
+  lease!.finish();
+  expect(window.isDestroyed()).toBe(true);
+  expect(f.quit).not.toHaveBeenCalled();
+  lease!.dispose();
+});
+it('locks a running session when its license expires', async () => {
+  vi.useFakeTimers({ toFake: ['setInterval', 'clearInterval'] });
+  const locked = vi.fn();
+  const promise = requireDeviceActivation(locked);
+  await vi.waitFor(() => expect(f.windows.length).toBe(1));
+  const window = f.windows[0];
+  const event = { sender: window.webContents, senderFrame: window.webContents.mainFrame };
+  f.verdict = { valid: true, claims: {} };
+  await f.handlers.get('device-license:activate')(event, 'verified');
+  const lease = await promise;
+  f.verdict = { valid: false, reason: 'expired' };
+  await vi.advanceTimersByTimeAsync(10000);
+  expect(locked).toHaveBeenCalledTimes(1);
+  lease!.finish();
+  lease!.dispose();
+});
diff --git a/electron/src/main/device-activation.ts b/electron/src/main/device-activation.ts
new file mode 100644
index 0000000..159ccec
--- /dev/null
+++ b/electron/src/main/device-activation.ts
@@ -0,0 +1,206 @@
+import {
+  app,
+  BrowserWindow,
+  clipboard,
+  ipcMain,
+  safeStorage,
+  type IpcMainInvokeEvent,
+} from 'electron';
+import { execFileSync } from 'node:child_process';
+import { readFile, mkdir } from 'node:fs/promises';
+import { join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import licenseConfig from '../../../config/license-authority.json';
+import { PRODUCT_NAME } from '../../../config/app-config.mjs';
+import { checkDeviceLicense, machineCode, type LicenseAuthority } from './device-license';
+import { replaceFile } from './replace-file';
+import { activationHtml } from './device-activation-view';
+
+interface State {
+  token: string;
+  lastSeen: number;
+}
+export interface ActivationLease {
+  finish(): void;
+  dispose(): void;
+}
+const noopLease: ActivationLease = { finish() {}, dispose() {} };
+
+export function currentMachineCode(): string {
+  let identity = '';
+  try {
+    if (process.platform === 'win32') {
+      const raw = execFileSync(
+        'reg.exe',
+        ['query', 'HKLM\\SOFTWARE\\Microsoft\\Cryptography', '/v', 'MachineGuid', '/reg:64'],
+        { encoding: 'utf8', windowsHide: true, timeout: 5000 },
+      );
+      identity = /MachineGuid\s+REG_SZ\s+([a-f0-9-]+)/i.exec(raw)?.[1] ?? '';
+    } else if (process.platform === 'darwin') {
+      const raw = execFileSync('ioreg', ['-rd1', '-c', 'IOPlatformExpertDevice'], {
+        encoding: 'utf8',
+        timeout: 5000,
+      });
+      identity = /"IOPlatformUUID"\s*=\s*"([a-f0-9-]+)"/i.exec(raw)?.[1] ?? '';
+    } else {
+      identity = execFileSync('cat', ['/etc/machine-id'], {
+        encoding: 'utf8',
+        timeout: 5000,
+      }).trim();
+    }
+  } catch {
+    throw new Error('Machine identity is unavailable');
+  }
+  return machineCode(
+    `${process.platform}:${
+      identity ||
+      (() => {
+        throw new Error('Machine identity is unavailable');
+      })()
+    }`,
+  );
+}
+
+export async function requireDeviceActivation(
+  onLocked: () => void,
+): Promise<ActivationLease | null> {
+  if (!licenseConfig.enabled) return noopLease;
+  const authority: LicenseAuthority[] = [licenseConfig.authority, ...licenseConfig.additionalAuthorities] as LicenseAuthority[];
+  const machine = currentMachineCode();
+  const path = join(app.getPath('userData'), 'device-activation.dat');
+  let state: State = { token: '', lastSeen: 0 };
+  try {
+    const raw = JSON.parse(safeStorage.decryptString(await readFile(path)));
+    if (typeof raw.token === 'string' && Number.isSafeInteger(raw.lastSeen) && raw.lastSeen >= 0)
+      state = raw;
+  } catch {
+    /* Missing or unreadable state never unlocks the app. */
+  }
+  async function save(next: State) {
+    if (!safeStorage.isEncryptionAvailable())
+      throw new Error('Secure activation storage unavailable');
+    await mkdir(dirname(path), { recursive: true });
+    await replaceFile(path, safeStorage.encryptString(JSON.stringify(next)));
+    state = next;
+  }
+  const now = () => Math.floor(Date.now() / 1000);
+  function monitor(finish: () => void): ActivationLease {
+    let stopped = false,
+      busy = false;
+    const timer = setInterval(async () => {
+      if (stopped || busy) return;
+      busy = true;
+      try {
+        const verdict = checkDeviceLicense(state.token, machine, authority, now(), state.lastSeen);
+        if (!verdict.valid) {
+          stopped = true;
+          clearInterval(timer);
+          onLocked();
+          return;
+        }
+        if (now() - state.lastSeen >= 60)
+          await save({ ...state, lastSeen: Math.max(state.lastSeen, now()) });
+      } catch {
+        stopped = true;
+        clearInterval(timer);
+        onLocked();
+      } finally {
+        busy = false;
+      }
+    }, 10000);
+    timer.unref();
+    const dispose = () => {
+      stopped = true;
+      clearInterval(timer);
+    };
+    app.once('before-quit', dispose);
+    return { finish, dispose };
+  }
+  const existing = checkDeviceLicense(state.token, machine, authority, now(), state.lastSeen);
+  let reason: string | undefined = state.token && !existing.valid ? existing.reason : undefined;
+  if (existing.valid) {
+    try {
+      await save({ ...state, lastSeen: Math.max(state.lastSeen, now()) });
+      return monitor(() => {});
+    } catch {
+      reason = 'storage';
+    }
+  }
+  return new Promise((resolve) => {
+    let accepted = false;
+    let activating = false;
+    const window = new BrowserWindow({
+      width: 760,
+      height: 710,
+      minWidth: 620,
+      minHeight: 600,
+      title: PRODUCT_NAME,
+      backgroundColor: '#0d1016',
+      show: false,
+      webPreferences: {
+        preload: join(dirname(fileURLToPath(import.meta.url)), '../preload/activation.cjs'),
+        contextIsolation: true,
+        nodeIntegration: false,
+        sandbox: true,
+      },
+    });
+    window.setMenu(null);
+    window.webContents.setWindowOpenHandler(() => ({ action: 'deny' }));
+    window.webContents.on('will-navigate', (event) => event.preventDefault());
+    function trusted(event: IpcMainInvokeEvent) {
+      if (
+        window.isDestroyed() ||
+        event.sender !== window.webContents ||
+        event.senderFrame !== window.webContents.mainFrame
+      )
+        throw new Error('Untrusted activation frame');
+    }
+    const channels = ['device-license:info', 'device-license:copy', 'device-license:activate'];
+    const cleanup = () => channels.forEach((channel) => ipcMain.removeHandler(channel));
+    ipcMain.handle(channels[0], (event) => {
+      trusted(event);
+      return { machine, reason };
+    });
+    ipcMain.handle(channels[1], (event) => {
+      trusted(event);
+      clipboard.writeText(machine);
+    });
+    ipcMain.handle(channels[2], async (event, token: unknown) => {
+      trusted(event);
+      if (typeof token !== 'string' || accepted || activating)
+        return { valid: false, reason: 'invalid' };
+      const verdict = checkDeviceLicense(token, machine, authority, now(), state.lastSeen);
+      if (!verdict.valid) return verdict;
+      activating = true;
+      try {
+        await save({ token: token.trim(), lastSeen: Math.max(state.lastSeen, now()) });
+      } catch {
+        return { valid: false, reason: 'storage' };
+      } finally {
+        activating = false;
+      }
+      accepted = true;
+      cleanup();
+      window.hide();
+      resolve(
+        monitor(() => {
+          if (!window.isDestroyed()) window.destroy();
+        }),
+      );
+      return { valid: true };
+    });
+    window.once('closed', () => {
+      cleanup();
+      if (!accepted) {
+        resolve(null);
+        app.quit();
+      }
+    });
+    window.once('ready-to-show', () => window.show());
+    void window
+      .loadURL('data:text/html;charset=utf-8,' + encodeURIComponent(activationHtml()))
+      .catch(() => {
+        if (!window.isDestroyed()) window.destroy();
+      });
+  });
+}

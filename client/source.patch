@@ -0,0 +1,64 @@
+"""No models, GPU or downloads: clocks use actual generated sample counts."""
+import sys
+from pathlib import Path
+import unittest
+sys.path.insert(0, str(Path(__file__).parents[1] / 'backend'))
+from services.line_subtitles import LineClock, script_lines, timestamp
+
+
+class LineSubtitleTests(unittest.TestCase):
+    def test_source_lines_and_sample_clock(self):
+        lines = script_lines('First sentence.\r\n\r\nSecond sentence.\rThird sentence.\n')
+        clock = LineClock(lines)
+        for frames in (12000, 24000, 36000):
+            clock.append(frames, 24000)
+        self.assertEqual(clock.srt(),
+            '1\n00:00:00,000 --> 00:00:00,500\nFirst sentence.\n\n'
+            '2\n00:00:00,500 --> 00:00:01,500\nSecond sentence.\n\n'
+            '3\n00:00:01,500 --> 00:00:03,000\nThird sentence.\n')
+
+    def test_half_second_pause_moves_next_cue_and_total_audio(self):
+        clock = LineClock(['first','second'])
+        self.assertEqual(clock.append(24000,24000,500),0)
+        self.assertEqual(clock.append(48000,24000,500),12000)
+        self.assertEqual(clock.frames,84000)
+        self.assertIn('00:00:01,500 --> 00:00:03,500',clock.srt())
+
+    def test_pause_has_no_leading_or_trailing_silence(self):
+        clock=LineClock(['only'])
+        self.assertEqual(clock.append(24000,24000,5000),0)
+        self.assertEqual(clock.frames,24000)
+        clock=LineClock(['one','two'])
+        clock.append(24000,24000,0);clock.append(24000,24000,0)
+        self.assertEqual(clock.frames,48000)
+
+    def test_invalid_pause_is_rejected(self):
+        for pause in [-1,5001,0.5]:
+            with self.assertRaises(ValueError):LineClock(['one']).append(24000,24000,pause)
+
+    def test_fractional_rate_does_not_accumulate_rounding_errors(self):
+        clock = LineClock(['sentence'] * 1000)
+        for _ in range(1000): clock.append(1001, 44100)
+        self.assertEqual(clock.frames, 1001000)
+        self.assertIn(timestamp(1001000, 44100), clock.srt().splitlines()[-2])
+
+    def test_unicode_original_text(self):
+        text = '\u65e5\u672c\u8a9e\n\ud55c\uad6d\uc5b4\nEspañol'
+        clock = LineClock(script_lines(text))
+        for _ in range(3): clock.append(24000,24000)
+        self.assertTrue(all(line in clock.srt() for line in text.splitlines()))
+
+    def test_empty_and_incomplete_are_rejected(self):
+        for clock in (LineClock([]), LineClock(['a'])):
+            with self.assertRaises(ValueError): clock.srt()
+
+    def test_zero_audio_and_rate_changes_are_rejected(self):
+        clock=LineClock(['a','b'])
+        with self.assertRaises(ValueError): clock.append(0,24000)
+        clock.append(24000,24000)
+        with self.assertRaises(ValueError): clock.append(48000,48000)
+
+    def test_timing_after_one_hour(self):
+        self.assertEqual(timestamp(44100*3600+22050,44100),'01:00:00,500')
+
+if __name__ == '__main__': unittest.main()

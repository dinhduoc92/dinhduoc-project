index 0000000..bd52146
--- /dev/null
+++ b/packaging/txt-srt/Update-VoiceStudio.ps1
@@ -0,0 +1,135 @@
+﻿param([string]$InstallDirectory = '', [switch]$Restore, [switch]$VerifyOnly)
+$ErrorActionPreference = 'Stop'
+$package = Split-Path -Parent $MyInvocation.MyCommand.Path
+$manifest = Get-Content -LiteralPath (Join-Path $package 'manifest.json') -Raw | ConvertFrom-Json
+function Hash([string]$path) { (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant() }
+function PayloadPath([string]$relative) { Join-Path (Join-Path $package 'payload') $relative }
+# Validate the entire payload before asking for or changing an installation.
+foreach ($entry in $manifest.files) {
+    $source = PayloadPath $entry.path
+    if (!(Test-Path -LiteralPath $source -PathType Leaf) -or (Hash $source) -ne $entry.patched) {
+        throw "Package is incomplete or damaged: $($entry.path). Extract the whole ZIP again."
+    }
+}
+if ($VerifyOnly) { Write-Host 'Payload checksums verified.'; exit 0 }
+if ($env:OS -ne 'Windows_NT') { throw 'This updater is for Windows x64.' }
+Add-Type -AssemblyName System.Windows.Forms
+if (!$InstallDirectory) {
+    $locations = @(
+        (Join-Path $env:LOCALAPPDATA 'Programs\VoiceStudio'),
+        (Join-Path $env:LOCALAPPDATA 'VoiceStudio'),
+        (Join-Path $env:ProgramFiles 'VoiceStudio')
+    )
+    $InstallDirectory = $locations | Where-Object { Test-Path -LiteralPath (Join-Path $_ 'resources\app.asar') } | Select-Object -First 1
+    if (!$InstallDirectory) {
+        $picker = New-Object System.Windows.Forms.FolderBrowserDialog
+        $picker.Description = 'Choose the folder containing VoiceStudio.exe (not the model/data folder).'
+        if ($picker.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) { exit 0 }
+        $InstallDirectory = $picker.SelectedPath
+        $picker.Dispose()
+    }
+}
+$InstallDirectory = [IO.Path]::GetFullPath($InstallDirectory)
+$resources = Join-Path $InstallDirectory 'resources'
+if (!(Test-Path -LiteralPath (Join-Path $InstallDirectory 'VoiceStudio.exe')) -or !(Test-Path -LiteralPath (Join-Path $resources 'app.asar'))) {
+    throw 'This is not a VoiceStudio desktop installation.'
+}
+if (Get-Process -Name 'VoiceStudio' -ErrorAction SilentlyContinue) {
+    throw 'Close VoiceStudio completely (including its tray icon), then run the updater again.'
+}
+if ($Restore) {
+    $backup = Get-ChildItem -LiteralPath $resources -Directory -Filter 'txt-srt-backup-*' |
+        Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName 'backup.json') } |
+        Sort-Object Name -Descending | Select-Object -First 1
+    if (!$backup) { throw 'No TXT-SRT backup was found.' }
+    $record = Get-Content -LiteralPath (Join-Path $backup.FullName 'backup.json') -Raw | ConvertFrom-Json
+    # Refuse to roll an unrelated app update back to an older shell.
+    foreach ($entry in $record.files) {
+        $target = Join-Path $resources $entry.path
+        if (Test-Path -LiteralPath $target) {
+            $current = Hash $target
+            if ($current -ne $entry.patched -and $current -ne $entry.original) {
+                throw "File changed after this update: $($entry.path). No files restored."
+            }
+        }
+        if ($entry.existed) {
+            $saved = Join-Path $backup.FullName $entry.path
+            if (!(Test-Path -LiteralPath $saved) -or (Hash $saved) -ne $entry.original) {
+                throw 'Backup is incomplete or damaged. No files restored.'
+            }
+        }
+    }
+    foreach ($entry in $record.files) {
+        $target = Join-Path $resources $entry.path
+        if ($entry.existed) { Copy-Item -LiteralPath (Join-Path $backup.FullName $entry.path) -Destination $target -Force }
+        elseif (Test-Path -LiteralPath $target) { Remove-Item -LiteralPath $target -Force }
+    }
+    Write-Host "Original app files restored. Backup: $($backup.FullName)"
+    exit 0
+}
+$alreadyInstalled = $true
+foreach ($entry in $manifest.files) {
+    $target = Join-Path $resources $entry.path
+    if (!(Test-Path -LiteralPath $target) -or (Hash $target) -ne $entry.patched) { $alreadyInstalled = $false }
+}
+if ($alreadyInstalled) { Write-Host 'TXT + Audio/SRT integration is already installed.'; exit 0 }
+# Only the exact official 0.5.8 x64 baseline is eligible. No model/runtime setup.
+foreach ($entry in $manifest.files) {
+    $target = Join-Path $resources $entry.path
+    if ($null -eq $entry.original) {
+        if (Test-Path -LiteralPath $target) { throw "An unexpected custom file exists: $($entry.path). No changes made." }
+    } elseif (!(Test-Path -LiteralPath $target) -or (Hash $target) -ne $entry.original) {
+        throw "This updater needs the unmodified official VoiceStudio 0.5.8 Windows x64 app. Different file: $($entry.path). No changes made."
+    }
+}
+$backupDir = Join-Path $resources ('txt-srt-backup-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + [guid]::NewGuid().ToString('N').Substring(0,6))
+New-Item -ItemType Directory -Path $backupDir | Out-Null
+$records = @()
+foreach ($entry in $manifest.files) {
+    $target = Join-Path $resources $entry.path
+    $existed = Test-Path -LiteralPath $target
+    if ($existed) {
+        $saved = Join-Path $backupDir $entry.path
+        New-Item -ItemType Directory -Path (Split-Path -Parent $saved) -Force | Out-Null
+        Copy-Item -LiteralPath $target -Destination $saved
+        if ((Hash $saved) -ne $entry.original) { throw 'Backup verification failed. Original app has not been modified.' }
+    }
+    $records += [pscustomobject]@{ path=$entry.path; original=$entry.original; patched=$entry.patched; existed=$existed }
+}
+@{ files=$records } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $backupDir 'backup.json') -Encoding UTF8
+$changed = @()
+$tempFiles = @()
+try {
+    foreach ($entry in $manifest.files) {
+        $target = Join-Path $resources $entry.path
+        New-Item -ItemType Directory -Path (Split-Path -Parent $target) -Force | Out-Null
+        $temporary = $target + '.txt-srt-' + [guid]::NewGuid().ToString('N') + '.tmp'
+        $tempFiles += $temporary
+        Copy-Item -LiteralPath (PayloadPath $entry.path) -Destination $temporary
+        if ((Hash $temporary) -ne $entry.patched) { throw 'Staged file checksum failed.' }
+        $changed += $entry.path
+        Move-Item -LiteralPath $temporary -Destination $target -Force
+    }
+    foreach ($entry in $manifest.files) {
+        if ((Hash (Join-Path $resources $entry.path)) -ne $entry.patched) { throw 'Installed checksum failed.' }
+    }
+} catch {
+    $failure = $_
+    $rollbackFailed = @()
+    foreach ($relative in $changed) {
+        try {
+            $entry = $records | Where-Object { $_.path -eq $relative } | Select-Object -First 1
+            $target = Join-Path $resources $relative
+            if ($entry.existed) { Copy-Item -LiteralPath (Join-Path $backupDir $relative) -Destination $target -Force }
+            elseif (Test-Path -LiteralPath $target) { Remove-Item -LiteralPath $target -Force }
+        } catch { $rollbackFailed += $relative }
+    }
+    if ($rollbackFailed.Count) { Write-Warning "Restore these files from $backupDir : $($rollbackFailed -join ', ')" }
+    throw $failure
+} finally {
+    foreach ($temporary in $tempFiles) { if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary -Force } }
+}
+Write-Host 'Updated. Open VoiceStudio, import TXT in Voice cloning, synthesize, then Save audio + SRT.'
+Write-Host 'For multiple TXT files: select WAV/MP3 + SRT, synthesize, then choose one output folder.'
+Write-Host "Backup kept at: $backupDir"
+Write-Host 'Saved voices, models, projects, settings and license acceptances were not changed.'

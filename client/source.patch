diff --git a/backend/services/generation_control.py b/backend/services/generation_control.py
new file mode 100644
index 0000000..180a724
--- /dev/null
+++ b/backend/services/generation_control.py
@@ -0,0 +1,68 @@
+"""In-memory, leased controls for one desktop line-synthesis batch."""
+import asyncio
+import re
+import time
+from dataclasses import dataclass, field
+
+
+@dataclass
+class BatchControl:
+    requested: bool = False
+    cancelled: bool = False
+    phase: str = 'running'
+    touched: float = field(default_factory=time.monotonic)
+    claimed: bool = False
+
+    def touch(self):
+        self.touched = time.monotonic()
+
+    def status(self):
+        if self.requested and not self.claimed:
+            self.phase = 'paused'
+        return {'state': self.phase, 'pause_requested': self.requested}
+
+    async def checkpoint(self, disconnected):
+        while True:
+            if self.cancelled or await disconnected():
+                raise asyncio.CancelledError('Batch stopped or its client disconnected')
+            if not self.requested:
+                self.phase = 'running'
+                return
+            self.phase = 'paused'
+            await asyncio.sleep(0.1)
+
+
+controls = {}
+
+
+def validate_id(key):
+    if not re.fullmatch(r'[a-f0-9]{32}', key):
+        raise ValueError('Invalid generation control ID')
+
+
+def start(key):
+    validate_id(key)
+    for old, state in list(controls.items()):
+        if state.cancelled or (not state.claimed and time.monotonic() - state.touched > 300):
+            state.cancelled = True
+            controls.pop(old, None)
+    if key in controls:
+        raise ValueError('Generation control already exists')
+    if len(controls) >= 32:
+        raise ValueError('Too many active generation controls')
+    controls[key] = BatchControl()
+    return controls[key]
+
+
+def get(key):
+    validate_id(key)
+    state = controls.get(key)
+    if state is None or state.cancelled or (not state.claimed and time.monotonic() - state.touched > 300):
+        raise KeyError('Generation control no longer exists')
+    return state
+
+
+def cancel(key):
+    state = controls.pop(key, None)
+    if state is not None:
+        state.cancelled = True
diff --git a/backend/services/line_subtitles.py b/backend/services/line_subtitles.py
new file mode 100644
index 0000000..c6f924c
--- /dev/null
+++ b/backend/services/line_subtitles.py
@@ -0,0 +1,50 @@
+"""Line-preserving subtitle timing, measured in generated audio samples."""
+from dataclasses import dataclass
+
+
+def script_lines(text: str) -> list[str]:
+    return [line.strip() for line in text.splitlines() if line.strip()]
+
+
+def timestamp(frames: int, sample_rate: int) -> str:
+    if frames < 0 or sample_rate <= 0:
+        raise ValueError("Invalid subtitle sample clock")
+    milliseconds = (frames * 1000 + sample_rate // 2) // sample_rate
+    seconds, milliseconds = divmod(milliseconds, 1000)
+    minutes, seconds = divmod(seconds, 60)
+    hours, minutes = divmod(minutes, 60)
+    return f"{hours:02}:{minutes:02}:{seconds:02},{milliseconds:03}"
+
+
+@dataclass
+class LineClock:
+    lines: list[str]
+    frames: int = 0
+    sample_rate: int | None = None
+
+    def __post_init__(self) -> None:
+        self.cues: list[str] = []
+
+    def append(self, frame_count: int, sample_rate: int, pause_ms: int = 0) -> int:
+        if len(self.cues) >= len(self.lines) or frame_count <= 0 or sample_rate <= 0:
+            raise ValueError("Missing or unexpected line audio")
+        if self.sample_rate is not None and self.sample_rate != sample_rate:
+            raise ValueError("Audio sample rate changed between lines")
+        if not isinstance(pause_ms, int) or not 0 <= pause_ms <= 5000:
+            raise ValueError("Line pause must be 0-5000 milliseconds")
+        self.sample_rate = sample_rate
+        pause_frames = (sample_rate * pause_ms + 500) // 1000 if self.cues else 0
+        self.frames += pause_frames
+        start = timestamp(self.frames, sample_rate)
+        end = timestamp(self.frames + frame_count, sample_rate)
+        if start == end:
+            raise ValueError("Line audio is too short for SRT")
+        index = len(self.cues)
+        self.cues.append(f"{index + 1}\n{start} --> {end}\n{self.lines[index]}\n")
+        self.frames += frame_count
+        return pause_frames
+
+    def srt(self) -> str:
+        if not self.lines or len(self.cues) != len(self.lines):
+            raise ValueError("Not all script lines have audio")
+        return "\n".join(self.cues)
diff --git a/backend/services/script_expression.py b/backend/services/script_expression.py
new file mode 100644
index 0000000..64ae3fe
--- /dev/null
+++ b/backend/services/script_expression.py
@@ -0,0 +1,61 @@
+"""Explicit script directions, never spoken words or subtitle text."""
+import functools
+import re
+
+DIRECTIONS = {
+    'angry': 'angry', 'shouting': 'shouting', 'choked-up': 'choked up, about to cry',
+    'crying': 'crying', 'sobbing': 'sobbing', 'pleading': 'pleading',
+    'anxious': 'anxious', 'afraid': 'afraid', 'panicked': 'panicked',
+    'trembling': 'with a trembling voice', 'hesitant': 'hesitant',
+    'stammering': 'stammering', 'sarcastic': 'sarcastic', 'mocking': 'mocking',
+    'arrogant': 'arrogant', 'scornful': 'scornful', 'scoff': 'scornful',
+    'tongue-click': '', 'whispering': 'whispering', 'mumbling': 'mumbling',
+    'gentle': 'gentle', 'reassuring': 'reassuring', 'gasp': '', 'gulp': '',
+}
+CUSTOM = re.compile(r'(?<!\[)\[(/?)(%s)\](?!\])' % '|'.join(map(re.escape, DIRECTIONS)), re.I)
+
+
+def has_directions(text):
+    return bool(CUSTOM.search(text))
+
+
+def parse_line(line):
+    directions = []
+    def remove(match):
+        direction = DIRECTIONS[match.group(2).lower()]
+        if not match.group(1) and direction and direction not in directions:
+            directions.append(direction)
+        return ''
+    return CUSTOM.sub(remove, line).strip(), ', '.join(directions)
+
+
+def caption_text(line):
+    from services.expression import OMNIVOICE_INLINE_TAGS, COSYVOICE_INLINE_TAGS
+    line = parse_line(line)[0]
+    for tag in set(OMNIVOICE_INLINE_TAGS + COSYVOICE_INLINE_TAGS):
+        line = re.sub(re.escape(tag), '', line, flags=re.I)
+    return line.strip()
+
+
+def audio_text(line, engine_cls):
+    from services.expression import OMNIVOICE_INLINE_TAGS, COSYVOICE_INLINE_TAGS
+    line = parse_line(line)[0]
+    supported = getattr(engine_cls, 'inline_tags', ())
+    for tag in set(OMNIVOICE_INLINE_TAGS + COSYVOICE_INLINE_TAGS):
+        if tag not in supported:
+            line = re.sub(re.escape(tag), '', line, flags=re.I)
+    return line.strip()
+
+
+def render_line_call(base, text, direction, engine_cls, pluggable, alpha=None):
+    from services.expression import apply_span_emotion
+    args = list(base.args)
+    args[1] = text
+    keywords = dict(base.keywords)
+    instruct_index = 5 if pluggable else 5
+    # Backend signature: backend, text, language, ref_audio, ref_text, instruct.
+    extra = dict(keywords.get('emotion_kwargs') or {})
+    args[instruct_index] = apply_span_emotion(engine_cls, extra, args[instruct_index], direction, alpha)
+    if pluggable:
+        keywords['emotion_kwargs'] = extra
+    return functools.partial(base.func, *args, **keywords)

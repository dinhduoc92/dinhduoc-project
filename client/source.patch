+"""No GPU: separate directions, audible text and sample-aligned captions."""
+import functools
+import sys
+import unittest
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).parents[1] / 'backend'))
+from services.script_expression import DIRECTIONS, parse_line, caption_text, audio_text, render_line_call
+from services.line_subtitles import LineClock
+
+class NoneEngine:
+    inline_tags = ()
+class DirectionEngine:
+    instruct_directs_delivery = True
+    inline_tags = ('[laughter]',)
+class GradedEngine:
+    supports_emotion = True
+
+class ScriptExpressionTests(unittest.TestCase):
+    def test_every_proposed_tag_is_never_spoken_or_captioned(self):
+        for tag in DIRECTIONS:
+            with self.subTest(tag=tag):
+                line=f'[{tag}] Hello world. [/{tag}]'
+                self.assertEqual(audio_text(line,NoneEngine),'Hello world.')
+                self.assertEqual(caption_text(line),'Hello world.')
+    def test_preserves_pronunciation_overrides_and_unrelated_brackets(self):
+        source='[2026] [[Tokyo|とうきょう]] [unknown]'
+        self.assertEqual(parse_line(source),(source,''))
+        self.assertEqual(parse_line('[[angry]]'),('[[angry]]',''))
+    def test_case_and_multiple_tags(self):
+        self.assertEqual(parse_line('[ANGRY][shouting] Go!'),('Go!','angry, shouting'))
+    def test_native_reactions_stay_only_in_supported_audio(self):
+        source='[angry][laughter] No.'
+        self.assertEqual(audio_text(source,DirectionEngine),'[laughter] No.')
+        self.assertEqual(audio_text(source,NoneEngine),'No.')
+        self.assertEqual(caption_text(source),'No.')
+    def test_tag_only_line_has_no_caption(self):
+        self.assertEqual(caption_text('[crying]'),'')
+    def test_multilingual_cues_keep_audio_sample_timing_and_pause(self):
+        lines=[caption_text(x) for x in ['[angry] 出ていけ！','[whispering] 조용히 해.']]
+        clock=LineClock(lines);clock.append(24000,24000,500);clock.append(48000,24000,500)
+        self.assertIn('00:00:01,500 --> 00:00:03,500\n조용히 해.',clock.srt())
+        self.assertNotIn('[',clock.srt())
+    def test_direction_is_per_line_and_does_not_modify_base_voice(self):
+        base=functools.partial(lambda *a,**k:(a,k),None,'text','en','ref','transcript','original',emotion_kwargs={'emo_audio':'saved'})
+        first=render_line_call(base,'Hello','whispering',DirectionEngine,True)()
+        second=render_line_call(base,'Next','',DirectionEngine,True)()
+        self.assertEqual(first[0][5],'original, whispering')
+        self.assertEqual(second[0][5],'original')
+        self.assertEqual(base.keywords['emotion_kwargs'],{'emo_audio':'saved'})
+    def test_graded_engine_receives_separate_emotion_not_spoken_tags(self):
+        base=functools.partial(lambda *a,**k:k,None,'text','en',None,None,None,emotion_kwargs={'emo_vector':[1]*8})
+        result=render_line_call(base,'Please','pleading',GradedEngine,True)()
+        self.assertEqual(result['emotion_kwargs']['emo_text'],'pleading')
+        self.assertNotIn('emo_vector',result['emotion_kwargs'])
+    def test_unsupported_engine_keeps_spoken_text_and_reference_unchanged(self):
+        base=functools.partial(lambda *a,**k:a,None,'text','en','ref','transcript','voice')
+        result=render_line_call(base,'Hello','crying',NoneEngine,False)()
+        self.assertEqual(result,(None,'Hello','en','ref','transcript','voice'))
+
+if __name__ == '__main__':unittest.main()

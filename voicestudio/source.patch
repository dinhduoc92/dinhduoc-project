diff --git a/electron/src/main/save-audio-subtitle-pair.test.ts b/electron/src/main/save-audio-subtitle-pair.test.ts
new file mode 100644
index 0000000..4327dd5
--- /dev/null
+++ b/electron/src/main/save-audio-subtitle-pair.test.ts
@@ -0,0 +1,46 @@
+import { mkdtemp, readFile, writeFile, readdir, rm } from 'node:fs/promises';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { afterEach, expect, it } from 'vitest';
+import { saveAudioSubtitlePair } from './save-audio-subtitle-pair';
+
+const dirs: string[] = [];
+afterEach(async () => {
+  await Promise.all(dirs.splice(0).map((p) => rm(p, { recursive: true, force: true })));
+});
+async function folder() {
+  const dir = await mkdtemp(join(tmpdir(), 'pair-'));
+  dirs.push(dir);
+  return dir;
+}
+const bytes = (s: string) => new TextEncoder().encode(s);
+it.each(['wav', 'mp3'])('saves the same basename as %s plus SRT', async (format) => {
+  const dir = await folder();
+  await saveAudioSubtitlePair(join(dir, `Bai_01.${format}`), bytes('audio'), bytes('subtitle'));
+  expect(await readFile(join(dir, 'Bai_01.srt'), 'utf8')).toBe('subtitle');
+  expect(await readFile(join(dir, `Bai_01.${format}`), 'utf8')).toBe('audio');
+});
+it('preserves an existing subtitle and rolls back the newly created audio', async () => {
+  const dir = await folder();
+  await writeFile(join(dir, 'Bai_01.srt'), 'existing');
+  await expect(
+    saveAudioSubtitlePair(join(dir, 'Bai_01.wav'), bytes('new'), bytes('new')),
+  ).rejects.toThrow();
+  expect(await readdir(dir)).toEqual(['Bai_01.srt']);
+  expect(await readFile(join(dir, 'Bai_01.srt'), 'utf8')).toBe('existing');
+});
+it('does not overwrite audio or publish its subtitle when audio already exists', async () => {
+  const dir = await folder();
+  await writeFile(join(dir, 'Bai_01.wav'), 'existing');
+  await expect(
+    saveAudioSubtitlePair(join(dir, 'Bai_01.wav'), bytes('new'), bytes('new')),
+  ).rejects.toThrow();
+  expect(await readdir(dir)).toEqual(['Bai_01.wav']);
+});
+it('rejects a misleading extension before writing either file', async () => {
+  const dir = await folder();
+  await expect(
+    saveAudioSubtitlePair(join(dir, 'Bai_01.srt'), bytes('audio'), bytes('srt')),
+  ).rejects.toThrow();
+  expect(await readdir(dir)).toEqual([]);
+});
diff --git a/electron/src/main/save-audio-subtitle-pair.ts b/electron/src/main/save-audio-subtitle-pair.ts
new file mode 100644
index 0000000..4ed3676
--- /dev/null
+++ b/electron/src/main/save-audio-subtitle-pair.ts
@@ -0,0 +1,29 @@
+import { open, unlink } from 'node:fs/promises';
+import { extname } from 'node:path';
+
+/** Never overwrite either half of a pair. Roll back files created by a failed save. */
+export async function saveAudioSubtitlePair(path: string, audio: Uint8Array, srt: Uint8Array) {
+  const extension = extname(path);
+  if (!['.wav', '.mp3'].includes(extension.toLowerCase()))
+    throw new Error('Choose a WAV or MP3 filename for the audio and SRT pair.');
+  const subtitle = path.slice(0, -extension.length) + '.srt';
+  const created: string[] = [];
+  try {
+    for (const [name, data] of [
+      [path, audio],
+      [subtitle, srt],
+    ] as const) {
+      const handle = await open(name, 'wx');
+      created.push(name);
+      try {
+        await handle.writeFile(data);
+        await handle.sync();
+      } finally {
+        await handle.close();
+      }
+    }
+  } catch (error) {
+    await Promise.all(created.map((name) => unlink(name).catch(() => {})));
+    throw error;
+  }
+}

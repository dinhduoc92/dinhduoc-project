+"""Exercise the actual finalizer with real files and no model downloads."""
+import ast
+import asyncio
+import contextlib
+import io
+import logging
+import os
+from pathlib import Path
+import sqlite3
+import tempfile
+import time
+import types
+import unittest
+from unittest.mock import patch
+import uuid
+import wave
+
+SOURCE = Path(__file__).parents[1] / 'backend/api/routers/generation.py'
+
+
+class SubtitleFinalizationTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.outputs = Path(self.tmp.name)
+        self.events = []
+        tree = ast.parse(SOURCE.read_text())
+        finalizer = next(node for node in tree.body if isinstance(node, ast.AsyncFunctionDef) and node.name == '_finalize_generation')
+        namespace = dict(asyncio=asyncio, time=time, uuid=uuid, Path=Path, os=os, sqlite3=sqlite3,
+                         OUTPUTS_DIR=str(self.outputs), logger=logging.getLogger('test'),
+                         take_reference_transcript=lambda x: x)
+        def save(path, tensor, rate, bits):
+            with wave.open(str(path),'wb') as wav:
+                wav.setparams((1,2,rate,0,'NONE','not compressed'))
+                wav.writeframes(b'\0\0'*tensor.shape[-1])
+        @contextlib.contextmanager
+        def db_conn():
+            test=self
+            class DB:
+                def execute(self, *args):
+                    # A take must not be published to history before its two files exist.
+                    if test.expected_srt:
+                        assert len(list(test.outputs.glob('*.wav')))==1
+                        assert len(list(test.outputs.glob('*.srt')))==1
+                    test.events.append('history')
+            yield DB()
+        namespace.update(save_generation_wav=save, db_conn=db_conn,
+                         _prune_history_over_cap=lambda **_: None,
+                         event_bus=types.SimpleNamespace(emit=lambda *args: self.events.append('published')))
+        exec(compile(ast.Module(body=[finalizer],type_ignores=[]),str(SOURCE),'exec'), namespace)
+        self.finalize=namespace['_finalize_generation']
+        self.expected_srt = True
+        self.tensor=types.SimpleNamespace(shape=(1,24000))
+
+    def run_finalize(self, **kwargs):
+        async def mark(tensor,*args,**kw): return tensor
+        watermark=types.ModuleType('services.watermark');watermark.mark_synthetic_async=mark
+        # Only the model-free finalizer is loaded; no Torch or app startup required.
+        services=types.ModuleType('services');services.__path__=[]
+        with patch.dict('sys.modules',{'services':services,'services.watermark':watermark}):
+            return asyncio.run(self.finalize(self.tensor,24000,text='Sentence',history_mode='clone',
+                ref_audio_path='reference.wav',language='English',instruct='',resolved_profile_id='voice',
+                used_seed=1,start_time=time.time(),include_wav_bytes=True,**kwargs))
+
+    def test_both_files_exist_before_history_publish(self):
+        _, meta=self.run_finalize(subtitle_srt='1\n00:00:00,000 --> 00:00:01,000\nSentence\n',subtitle_frames=24000)
+        self.assertEqual(self.events,['history','published'])
+        self.assertEqual((self.outputs/f'{meta["id"]}.srt').read_text(encoding='utf-8-sig').splitlines()[-1],'Sentence')
+        with wave.open(io.BytesIO(meta['_wav_bytes'])) as wav:
+            self.assertEqual(wav.getnframes(),24000)
+
+    def test_changed_final_length_never_publishes_wrong_subtitles(self):
+        with self.assertRaises(ValueError): self.run_finalize(subtitle_srt='subtitles',subtitle_frames=48000)
+        self.assertEqual(list(self.outputs.iterdir()),[])
+        self.assertEqual(self.events,[])
+
+    def test_subtitle_write_failure_removes_audio_before_publish(self):
+        original=Path.open
+        def fail(path,*args,**kwargs):
+            if path.suffix=='.srt': raise OSError('disk full')
+            return original(path,*args,**kwargs)
+        with patch.object(Path,'open',fail):
+            with self.assertRaises(OSError): self.run_finalize(subtitle_srt='subtitles',subtitle_frames=24000)
+        self.assertEqual(list(self.outputs.iterdir()),[])
+        self.assertEqual(self.events,[])
+
+    def test_standard_audio_generation_does_not_create_a_sidecar(self):
+        self.expected_srt=False
+        self.run_finalize()
+        self.assertEqual(len(list(self.outputs.glob('*.wav'))),1)
+        self.assertEqual(list(self.outputs.glob('*.srt')),[])
+
+if __name__=='__main__': unittest.main()

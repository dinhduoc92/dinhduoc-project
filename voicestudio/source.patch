@@ -0,0 +1,82 @@
+"""Cross-platform logic tests; no real Windows app or user data is touched."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+SCRIPT = Path(__file__).parents[1] / 'packaging/txt-srt/Update-VoiceStudio.ps1'
+PWSH = os.environ.get('TXT_SRT_PWSH') or shutil.which('pwsh')
+
+@unittest.skipUnless(PWSH, 'PowerShell is required for updater logic tests')
+class UpdaterTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup)
+        root=Path(self.temp.name);self.package=root/'package';self.app=root/'app';self.resources=self.app/'resources'
+        self.package.mkdir();self.resources.mkdir(parents=True);(self.app/'VoiceStudio.exe').write_bytes(b'fixture only')
+        shutil.copy2(SCRIPT,self.package/SCRIPT.name)
+        self.entries=[]
+        for rel in ['app.asar','backend/api/routers/generation.py','backend/core/csrf.py','backend/services/line_subtitles.py']:
+            payload=self.package/'payload'/rel;payload.parent.mkdir(parents=True,exist_ok=True)
+            payload.write_bytes(('updated '+rel).encode())
+            original=None
+            if not rel.endswith('line_subtitles.py'):
+                target=self.resources/rel;target.parent.mkdir(parents=True,exist_ok=True)
+                target.write_bytes(('original '+rel).encode());original=self.digest(target)
+            self.entries.append(dict(path=rel,patched=self.digest(payload),original=original))
+        (self.package/'manifest.json').write_text(json.dumps(dict(files=self.entries)))
+
+    @staticmethod
+    def digest(path):return hashlib.sha256(path.read_bytes()).hexdigest()
+
+    def run_updater(self, restore=False, prelude=''):
+        # Only Forms loading is stubbed. With an explicit directory no dialog is executed.
+        command="$ErrorActionPreference='Stop'; function Add-Type { param([string]$AssemblyName) }; $env:OS='Windows_NT'; "
+        command+=prelude+f" & '{self.package/SCRIPT.name}' -InstallDirectory '{self.app}'"+(' -Restore' if restore else '')
+        env=dict(os.environ,XDG_CACHE_HOME=str(self.package/'cache'),XDG_CONFIG_HOME=str(self.package/'config'),XDG_DATA_HOME=str(self.package/'data'))
+        return subprocess.run([PWSH,'-NoProfile','-Command',command],capture_output=True,text=True,env=env)
+
+    def assert_original(self):
+        for entry in self.entries:
+            target=self.resources/entry['path']
+            if entry['original'] is None:self.assertFalse(target.exists())
+            else:self.assertEqual(self.digest(target),entry['original'])
+
+    def test_install_idempotence_and_restore(self):
+        result=self.run_updater();self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+        for entry in self.entries:self.assertEqual(self.digest(self.resources/entry['path']),entry['patched'])
+        result=self.run_updater();self.assertEqual(result.returncode,0,result.stderr)
+        self.assertEqual(len(list(self.resources.glob('txt-srt-backup-*'))),1)
+        result=self.run_updater(restore=True);self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+        self.assert_original()
+
+    def test_corrupt_package_is_rejected_before_app_changes(self):
+        (self.package/'payload/app.asar').write_bytes(b'corrupt')
+        self.assertNotEqual(self.run_updater().returncode,0);self.assert_original()
+        self.assertEqual(list(self.resources.glob('txt-srt-backup-*')),[])
+
+    def test_other_installed_version_is_not_modified(self):
+        target=self.resources/'app.asar';target.write_bytes(b'other version')
+        self.assertNotEqual(self.run_updater().returncode,0)
+        self.assertEqual(target.read_bytes(),b'other version')
+        self.assertEqual(list(self.resources.glob('txt-srt-backup-*')),[])
+
+    def test_write_failure_rolls_back_previous_updated_files(self):
+        prelude=r'''function Copy-Item {
+            param([string]$LiteralPath,[string]$Destination,[switch]$Force)
+            if ($Destination -like '*csrf.py.txt-srt-*.tmp') { throw 'simulated disk failure' }
+            Microsoft.PowerShell.Management\Copy-Item @PSBoundParameters
+        };'''
+        result=self.run_updater(prelude=prelude);self.assertNotEqual(result.returncode,0)
+        self.assert_original()
+
+    def test_restore_does_not_overwrite_a_subsequent_app_update(self):
+        self.assertEqual(self.run_updater().returncode,0)
+        (self.resources/'app.asar').write_bytes(b'later app version')
+        self.assertNotEqual(self.run_updater(restore=True).returncode,0)
+        self.assertEqual((self.resources/'app.asar').read_bytes(),b'later app version')
+
+if __name__=='__main__':unittest.main()
